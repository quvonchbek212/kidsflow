# === KIDSFLOW docker-compose ildiz .env namunasi ===
# Bu qiymatlar docker-compose.yml tomonidan ishlatiladi.

# --- PostgreSQL ---
POSTGRES_USER=kidsflow
POSTGRES_PASSWORD=kidsflow
POSTGRES_DB=kidsflow

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Production (docker-compose.prod.yml uchun) ---
# Saytning ommaviy manzili. CORS ro'yxatiga shu qiymat tushadi; ko'rsatilmasa
# production konfiguratsiyasi ataylab ishga tushmaydi.
PUBLIC_ORIGIN=https://sizning-domen.uz

# Konteynerlar vaqt zonasi (taqvim hisoblari uchun).
TZ=Asia/Tashkent
