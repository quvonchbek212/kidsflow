# === KIDSFLOW Telegram bot .env namunasi ===
# BotFather'dan olingan token. Har bir bog'cha uchun alohida bot (2.2-bo'lim).
BOT_TOKEN=

# Backend API manzili (Docker ichida: http://backend:8000/api/v1)
BACKEND_API_URL=http://backend:8000/api/v1

# Backend bot endpointlariga kirish siri — backend BOT_API_TOKEN bilan bir xil.
BACKEND_BOT_TOKEN=change-me-bot-api-token

DEFAULT_LANGUAGE=uz
REQUEST_TIMEOUT_SECONDS=10
