# o'qiydi va NEXT_PUBLIC_* qiymatlarini bundle'ga yozadi — bu yerda uni istisno
# qilmasak, lokal qiymat production image'iga kirib qolardi.
.env
.env.*
!.env.example

.git/
Dockerfile
