# === KIDSFLOW backend .env namunasi ===
# Har bir bog'cha (deployment) uchun alohida to'ldiriladi (2.2-bo'lim).
# Ushbu faylni `.env` nomi bilan nusxalab, qiymatlarni o'zgartiring.

# --- Umumiy ---
ENVIRONMENT=development
DEBUG=true
APP_NAME=KIDSFLOW
API_V1_PREFIX=/api/v1

TIMEZONE=Asia/Tashkent
DEFAULT_LANGUAGE=uz
CURRENCY=UZS

# --- Xavfsizlik (production'da albatta o'zgartiring!) ---
SETUP_TOKEN=change-me-setup-token
JWT_SECRET=change-me-jwt-secret-min-16-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Tibbiy/sog'liq ma'lumotlarini shifrlash kaliti (parol-satr).
ENCRYPTION_KEY=change-me-encryption-key
# Telegram bot backend API'ga kirishi uchun umumiy sir (X-Bot-Token).
BOT_API_TOKEN=change-me-bot-api-token
# Telegram taklif kodi amal qilish muddati (daqiqa).
INVITATION_TTL_MINUTES=60

# --- Fayl saqlash (11-bo'lim) ---
FILE_STORAGE_PATH=storage
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,application/pdf

# --- Worker / bildirishnoma (9-bo'lim) ---
# Backend worker Telegram xabar yuborishi uchun bot tokeni (BotFather'dan).
# Bo'sh bo'lsa, bildirishnomalar navbatda qoladi (yuborilmaydi).
TELEGRAM_BOT_TOKEN=
WORKER_POLL_INTERVAL_SECONDS=5
OUTBOX_MAX_RETRIES=5

# --- Rate limiting (11-bo'lim) ---
RATE_LIMIT_ENABLED=true
# "memory" (bitta instans) yoki "redis" (bir nechta instans — production).
RATE_LIMIT_BACKEND=memory
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
SETUP_RATE_LIMIT_MAX=5
SETUP_RATE_LIMIT_WINDOW_SECONDS=300

# --- Monitoring ---
REQUEST_LOGGING_ENABLED=true

# --- AI / Gemini (10-bo'lim) ---
# AI standart o'chirilgan. Yoqish uchun AI_ENABLED=true va GEMINI_API_KEY.
AI_ENABLED=false
GEMINI_API_KEY=
# Markaziy AI gateway (ixtiyoriy). Bo'sh bo'lsa Google endpointi ishlatiladi.
AI_GATEWAY_URL=
AI_MODEL=gemini-2.0-flash
AI_REQUEST_TIMEOUT_SECONDS=30
# Oylik token limiti (0 = cheksiz).
AI_MONTHLY_TOKEN_LIMIT=0
AI_INPUT_COST_PER_MILLION=0.10
AI_OUTPUT_COST_PER_MILLION=0.40

# --- Ma'lumotlar bazasi ---
# Docker ichida host nomi: `postgres`. Lokal ishga tushirishda: `localhost`.
DATABASE_URL=postgresql+asyncpg://kidsflow:kidsflow@postgres:5432/kidsflow
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- CORS (vergul bilan ajratilgan) ---
CORS_ORIGINS=http://localhost:3000

# --- Email (parolni tiklash uchun SMTP) ---
# Bo'sh bo'lsa, tiklash havolasi yuborilmaydi (log'ga yoziladi).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=KIDSFLOW
PASSWORD_RESET_TTL_MINUTES=30
